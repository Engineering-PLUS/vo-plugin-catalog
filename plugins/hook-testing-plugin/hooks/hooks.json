{
  "description": "Generic logger wired to every hook event that's safe to observe live, for the hook-lab test harness. Each wiring goes through a fail-open wrapper (`sh -c '...; exit 0'`) so the logger can never block an event, even if the script itself is corrupted or aborts at parse time. WorktreeCreate is deliberately NOT wired here -- see README.md#hook-test-harness-hook-lab.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "Setup": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "sh", "args": ["-c", "sh \"$1\" 2>/dev/null; exit 0", "hook-lab-logger", "${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh"] }]
      }
    ],
    "Notification": [

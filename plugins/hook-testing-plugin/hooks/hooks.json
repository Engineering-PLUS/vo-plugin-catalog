{
  "description": "Generic logger wired to every hook event that's safe to observe live, for the hook-lab test harness. One shell-form command valid in sh, Git Bash, AND PowerShell (the three shells Claude Code routes shell form to): the .ps1 does the work on Windows hosts (PowerShell is the only interpreter guaranteed there -- hooks run on the HOST in Cowork Chat, per 2026-08-19 field reports), the .sh does it on POSIX, and each no-ops on the other's platform so nothing double-logs. Trailing `exit 0` is valid in both shell families, so the logger can never block an event. WorktreeCreate is deliberately NOT wired here -- see README.md#hook-test-harness-hook-lab.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.ps1\"; sh \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh\"; exit 0" }]
      }
    ],
    "Setup": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.ps1\"; sh \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh\"; exit 0" }]
      }
    ],
    "InstructionsLoaded": [
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.ps1\"; sh \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh\"; exit 0" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.ps1\"; sh \"${CLAUDE_PLUGIN_ROOT}/scripts/log-event.sh\"; exit 0" }]
      }
    ],
    "UserPromptExpansion": [
